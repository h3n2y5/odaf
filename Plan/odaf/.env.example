APP_NAME=ODAF
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8080
APP_PORT=8080

LOG_CHANNEL=stack
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Oracle Metadata Repository (BB-01)
# -----------------------------------------------------------------------------
DB_CONNECTION=oracle
DB_HOST=oracle
DB_PORT=1521
DB_SERVICE_NAME=FREEPDB1
DB_DATABASE=FREEPDB1
DB_USERNAME=ODAF
DB_PASSWORD=OdafApp2026
DB_SYSTEM_PASSWORD=OdafSys2026

# Design-time vs runtime schema (isolasi CORE-004). Untuk dev, satu schema.
ODAF_DESIGN_SCHEMA=ODAF
ODAF_RUNTIME_SCHEMA=ODAF

# -----------------------------------------------------------------------------
# ODAF platform
# -----------------------------------------------------------------------------
# Strategi pembangkitan OBJECT_ID: ulid | uuid7
ODAF_ID_STRATEGY=ulid
# Cache runtime package terkompilasi
ODAF_RUNTIME_CACHE=file

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
